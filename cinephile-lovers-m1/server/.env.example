# Port the server listens on (Render sets PORT itself in production).
PORT=4000

# development | production | test
NODE_ENV=development

# Exact origin of the deployed frontend. Requests from any other origin are
# refused. Vercel preview URLs are deliberately NOT allowed (owner decision) —
# test preview builds on a stable alias that is explicitly set here.
FRONTEND_URL=http://localhost:3000

# Rooms expire after this many hours without activity. Memory-only server.
ROOM_TTL_HOURS=12

# Room creation rate limit (per IP, fixed window). Sanity brake until M7
# re-verifies trust proxy on Render.
ROOM_CREATE_RATE_LIMIT=10
ROOM_CREATE_RATE_WINDOW_MIN=10

# DEV ONLY — extra allowed origins, comma-separated, for real-device testing
# on your LAN (an iPhone cannot present a localhost origin). Example:
# DEV_EXTRA_ORIGINS=http://192.168.1.20:3000
# Ignored entirely when NODE_ENV is not "development". Keep empty otherwise.
DEV_EXTRA_ORIGINS=