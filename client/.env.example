# Base URLs of the backend REST API and Socket.IO endpoint. For phone testing,
# replace localhost with the forwarded server URL; localhost on the phone
# points to the phone itself.
#
# These are INLINED AT BUILD TIME. On Vercel or Pxxl they must be set in the
# project's Environment Variables / Secrets to the deployed server origin
# (https), e.g.
#   NEXT_PUBLIC_API_URL=https://your-server.onrender.com
#   NEXT_PUBLIC_SOCKET_URL=https://your-server.onrender.com
# If they are missing, the production build falls back to localhost and cannot
# reach the server.
NEXT_PUBLIC_API_URL=http://localhost:4000

NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
